# Cloudflare Tunnel Configuration
# Copy to /etc/cloudflared/config.yml and update with your values

tunnel: YOUR_TUNNEL_ID_HERE
credentials-file: /root/.cloudflared/YOUR_TUNNEL_ID.json

ingress:
  # Website 1 - Running on Server 1 (Port 8000)
  - hostname: website1.yourdomain.com
    service: http://localhost:8000
  
  # Motrac - Running on Server 2
  # Option 1: Direct connection (if Server 2 is accessible)
  - hostname: motrac.yourdomain.com
    service: http://server2-ip:8001
  
  # Option 2: Via SSH Tunnel (more secure)
  # Uncomment below and comment above if using SSH tunnel
  # - hostname: motrac.yourdomain.com
  #   service: http://localhost:8001
  #   originRequest:
  #     httpHostHeader: motrac.yourdomain.com
  #     connectTimeout: 10s
  #     tcpKeepAlive: 30s
  #     http2Origin: true
  
  # Catch-all rule (MUST be last)
  - service: http_status:404

