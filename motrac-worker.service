[Unit]
Description=Motrac Queue Worker
After=network.target mysql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/motrac
ExecStart=/usr/bin/php /var/www/motrac/artisan queue:work --sleep=3 --tries=3 --max-time=3600
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/motrac/storage /var/www/motrac/bootstrap/cache

[Install]
WantedBy=multi-user.target

